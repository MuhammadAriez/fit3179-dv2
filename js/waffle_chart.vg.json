{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Panel 1: Every 100 full-time equivalent students in Australia in 2025, by school sector. Source: ABS, Schools 2025, Table 43a.",
  "width": 300,
  "height": 300,
  "data": {"url": "data/enrolments.csv", "format": {"parse": {"fte_students": "number"}}},
  "transform": [
    {"filter": "datum.year == 2025 && datum.state == 'Australia'"},
    {"joinaggregate": [{"op": "sum", "field": "fte_students", "as": "total"}]},
    {"calculate": "round(datum.fte_students / datum.total * 100)", "as": "squares"},
    {"calculate": "datum.sector == 'Government' ? 1 : datum.sector == 'Catholic' ? 2 : 3", "as": "sector_order"},
    {"calculate": "sequence(0, datum.squares)", "as": "square_list"},
    {"flatten": ["square_list"]},
    {"window": [{"op": "row_number", "as": "position"}], "sort": [{"field": "sector_order"}, {"field": "square_list"}]},
    {"calculate": "(datum.position - 1) % 10", "as": "col"},
    {"calculate": "floor((datum.position - 1) / 10)", "as": "row"}
  ],
    "mark": {"type": "rect", "stroke": "white", "strokeWidth": 3},
  "encoding": {
    "x": {"field": "col", "type": "ordinal", "axis": null},
    "y": {"field": "row", "type": "ordinal", "axis": null},
    "color": {
      "field": "sector",
      "type": "nominal",
      "title": null,
      "scale": {"domain": ["Government", "Catholic", "Independent"], "range": ["#3a3f4b", "#7b8291", "#b9bec8"]},
      "legend": {"orient": "bottom", "direction": "horizontal"}
    },
    "tooltip": [
      {"field": "sector", "type": "nominal", "title": "Sector"},
      {"field": "squares", "type": "quantitative", "title": "Students out of every 100"}
    ]
  },
  "config": {"font": "Atkinson Hyperlegible", "view": {"stroke": null}}
}