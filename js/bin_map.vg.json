{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Panel 14: Number of schools in each hexagon (about 110 km across), by school sector, Australia, 2025. Source: Australian Curriculum, Assessment and Reporting Authority, School Location 2025.",
  "width": 500,
  "height": 420,
  "signals": [
    {
      "name": "sector",
      "value": "All schools",
      "bind": {"input": "select", "options": ["All schools", "Government", "Catholic", "Independent"], "name": "Show: "}
    },
    {"name": "hexRadius", "value": 7},
    {"name": "hexWidth", "update": "sqrt(3) * hexRadius"}
  ],
  "projections": [
    {
      "name": "projection",
      "type": "conicEqualArea",
      "parallels": [-18, -36],
      "rotate": [-132, 0],
      "fit": {"signal": "data('states')"},
      "size": {"signal": "[width, height]"}
    }
  ],
  "data": [
    {
      "name": "states",
      "url": "data/geo/aus_states.topojson",
      "format": {"type": "topojson", "feature": "states"}
    },
    {
      "name": "hexes",
      "url": "data/schools_2025.csv",
      "format": {"type": "csv", "parse": {"lon": "number", "lat": "number"}},
      "transform": [
        {"type": "filter", "expr": "sector == 'All schools' || datum.sector == sector"},
        {"type": "geopoint", "projection": "projection", "fields": ["lon", "lat"], "as": ["x", "y"]},
        {"type": "formula", "expr": "round(datum.y / (1.5 * hexRadius))", "as": "row"},
        {"type": "formula", "expr": "(datum.row % 2) * hexWidth / 2", "as": "shift"},
        {"type": "formula", "expr": "round((datum.x - datum.shift) / hexWidth) * hexWidth + datum.shift", "as": "hex_x"},
        {"type": "formula", "expr": "datum.row * 1.5 * hexRadius", "as": "hex_y"},
        {"type": "aggregate", "groupby": ["hex_x", "hex_y"], "ops": ["count"], "as": ["schools"]}
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "threshold",
      "domain": [2, 5, 15, 50],
      "range": ["#f6e0d9", "#e8a995", "#d1715a", "#a8432d", "#6e2214"]
    }
  ],
  "legends": [
    {
      "fill": "color",
      "type": "symbol",
      "title": "Schools in each hexagon",
      "orient": "bottom",
      "direction": "horizontal",
      "symbolType": "square",
      "symbolSize": 120,
      "encode": {
        "labels": {"update": {"text": {"signal": "['1', '2 to 4', '5 to 14', '15 to 49', '50 or more'][datum.index]"}}}
      }
    }
  ],
  "marks": [
    {
      "type": "shape",
      "from": {"data": "states"},
      "encode": {
        "update": {
          "fill": {"value": "#eceef2"},
          "stroke": {"value": "white"},
          "strokeWidth": {"value": 1.5}
        }
      },
      "transform": [{"type": "geoshape", "projection": "projection"}]
    },
    {
      "type": "symbol",
      "from": {"data": "hexes"},
      "encode": {
        "update": {
          "x": {"field": "hex_x"},
          "y": {"field": "hex_y"},
          "shape": {"value": "M0,-1L0.866,-0.5L0.866,0.5L0,1L-0.866,0.5L-0.866,-0.5Z"},
          "size": {"signal": "4 * hexRadius * hexRadius"},
          "fill": {"scale": "color", "field": "schools"},
          "stroke": {"value": "white"},
          "strokeWidth": {"value": 0.5},
          "tooltip": {"signal": "{'Schools in this hexagon': datum.schools, 'Showing': sector}"}
        }
      }
    }
  ],
  "config": {
    "text": {"font": "Atkinson Hyperlegible"},
    "legend": {"labelFont": "Atkinson Hyperlegible", "titleFont": "Atkinson Hyperlegible", "labelFontSize": 12, "titleFontSize": 12}
  }
}
