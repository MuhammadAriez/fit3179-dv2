{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Figure 7: Number of schools in each hexagon, by school sector, Australia, 2025. Source: Australian Curriculum, Assessment and Reporting Authority, School Location 2025. Zoom to a city or with the slider.",
  "signals": [
    {"name": "width", "init": "min(containerSize()[0], 500)", "on": [{"events": "window:resize", "update": "min(containerSize()[0], 500)"}]},
    {"name": "height", "update": "width * 0.84"},
    {
      "name": "sector",
      "value": "All schools",
      "bind": {
        "input": "radio",
        "options": [
          "All schools",
          "Government",
          "Catholic",
          "Independent"
        ],
        "name": "Show: "
      }
    },
    {
      "name": "hexRadius",
      "value": 7
    },
    {
      "name": "hexWidth",
      "update": "sqrt(3) * hexRadius"
    },
    {
      "name": "place",
      "value": "All of Australia",
      "bind": {
        "input": "select",
        "options": [
          "All of Australia",
          "Sydney",
          "Melbourne",
          "Brisbane",
          "Adelaide",
          "Perth"
        ],
        "name": "Zoom to: "
      }
    },
    {
      "name": "zoom",
      "value": 1,
      "bind": {
        "input": "range",
        "min": 1,
        "max": 6,
        "step": 0.5,
        "name": "Zoom: "
      },
      "on": [
        {
          "events": {
            "signal": "place"
          },
          "update": "place == 'All of Australia' ? 1 : 5"
        }
      ]
    },
    {
      "name": "centre",
      "update": "place == 'Sydney' ? [151.21 - 132, -33.87] : place == 'Melbourne' ? [144.96 - 132, -37.81] : place == 'Brisbane' ? [153.03 - 132, -27.47] : place == 'Adelaide' ? [138.60 - 132, -34.93] : place == 'Perth' ? [115.86 - 132, -31.95] : [1.5, -27.2]"
    },
    {
      "name": "baseScale",
      "update": "width * 1.38"
    },
    {
      "name": "hexKm",
      "update": "hexWidth * 6371 / (baseScale * zoom)"
    }
  ],
  "projections": [
    {
      "name": "projection",
      "type": "conicEqualArea",
      "parallels": [
        -18,
        -36
      ],
      "rotate": [
        -132,
        0
      ],
      "center": {
        "signal": "centre"
      },
      "scale": {
        "signal": "baseScale * zoom"
      },
      "translate": {
        "signal": "[width / 2, height / 2]"
      }
    }
  ],
  "data": [
    {
      "name": "states",
      "url": "data/geo/aus_states.topojson",
      "format": {
        "type": "topojson",
        "feature": "states"
      }
    },
    {
      "name": "hexes",
      "url": "data/schools_2025.csv",
      "format": {
        "type": "csv",
        "parse": {
          "lon": "number",
          "lat": "number"
        }
      },
      "transform": [
        {
          "type": "filter",
          "expr": "sector == 'All schools' || datum.sector == sector"
        },
        {
          "type": "geopoint",
          "projection": "projection",
          "fields": [
            "lon",
            "lat"
          ],
          "as": [
            "x",
            "y"
          ]
        },
        {
          "type": "formula",
          "expr": "round(datum.y / (1.5 * hexRadius))",
          "as": "row"
        },
        {
          "type": "formula",
          "expr": "(datum.row % 2) * hexWidth / 2",
          "as": "shift"
        },
        {
          "type": "formula",
          "expr": "round((datum.x - datum.shift) / hexWidth) * hexWidth + datum.shift",
          "as": "hex_x"
        },
        {
          "type": "formula",
          "expr": "datum.row * 1.5 * hexRadius",
          "as": "hex_y"
        },
        {
          "type": "aggregate",
          "groupby": [
            "hex_x",
            "hex_y"
          ],
          "ops": [
            "count"
          ],
          "as": [
            "schools"
          ]
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "threshold",
      "domain": [
        2,
        5,
        15,
        50
      ],
      "range": [
        "#f6e0d9",
        "#e8a995",
        "#d1715a",
        "#a8432d",
        "#6e2214"
      ]
    }
  ],
  "legends": [
    {
      "fill": "color",
      "type": "symbol",
      "title": "Schools in each hexagon",
      "orient": "bottom",
      "direction": "horizontal",
      "symbolType": "square",
      "symbolSize": 120,
      "encode": {
        "labels": {
          "update": {
            "text": {
              "signal": "['1', '2 to 4', '5 to 14', '15 to 49', '50 or more'][datum.index]"
            }
          }
        }
      }
    }
  ],
  "marks": [
    {
      "type": "shape",
      "from": {
        "data": "states"
      },
      "encode": {
        "update": {
          "fill": {
            "value": "#eceef2"
          },
          "stroke": {
            "value": "white"
          },
          "strokeWidth": {
            "value": 1.5
          }
        }
      },
      "transform": [
        {
          "type": "geoshape",
          "projection": "projection"
        }
      ],
      "clip": true
    },
    {
      "type": "symbol",
      "from": {
        "data": "hexes"
      },
      "encode": {
        "update": {
          "x": {
            "field": "hex_x"
          },
          "y": {
            "field": "hex_y"
          },
          "shape": {
            "value": "M0,-1L0.866,-0.5L0.866,0.5L0,1L-0.866,0.5L-0.866,-0.5Z"
          },
          "size": {
            "signal": "4 * hexRadius * hexRadius"
          },
          "fill": {
            "scale": "color",
            "field": "schools"
          },
          "stroke": {
            "value": "white"
          },
          "strokeWidth": {
            "value": 0.5
          },
          "tooltip": {
            "signal": "{'Schools in this hexagon': datum.schools, 'Showing': sector, 'Hexagon width': format(hexKm, '.0f') + ' km'}"
          }
        }
      },
      "clip": true
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "y": {
            "value": 12
          },
          "text": {
            "signal": "'Each hexagon is about ' + format(hexKm, '.0f') + ' km across'"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#4a5263"
          }
        }
      }
    }
  ],
  "config": {
    "text": {
      "font": "Atkinson Hyperlegible"
    },
    "legend": {
      "labelFont": "Atkinson Hyperlegible",
      "titleFont": "Atkinson Hyperlegible",
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  }
}