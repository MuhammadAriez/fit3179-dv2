{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Panel 10: Government recurrent funding per student, all schools, by state and territory, 2014-15 and 2023-24, in 2023-24 dollars. Click a line to highlight a state. Source: Productivity Commission, Report on Government Services 2026, Table 4A.32.",
  "width": "container",
  "height": 380,
  "data": {"url": "data/gov_funding_real.csv", "format": {"parse": {"per_student_real_2023_24_aud": "number"}}},
  "transform": [
    {"filter": "datum.sector == 'All' && datum.source == 'Total government' && (datum.year == '2014-15' || datum.year == '2023-24')"},
    {"filter": "datum.state_abbr != 'Aust'"},
    {"calculate": "format(datum.per_student_real_2023_24_aud, '$,.0f')", "as": "value_label"}
  ],
  "encoding": {
    "x": {"field": "year", "type": "ordinal", "title": null, "axis": {"labelAngle": 0}},
    "y": {"field": "per_student_real_2023_24_aud", "type": "quantitative", "scale": {"domain": [15000, 35000]}, "axis": {"format": "$,.0f", "values": [15000, 20000, 25000, 30000, 35000]}, "title": "Funding per student"},
    "detail": {"field": "state_abbr", "type": "nominal"},
    "tooltip": [
      {"field": "state", "type": "nominal", "title": "State or territory"},
      {"field": "year", "type": "ordinal", "title": "Year"},
      {"field": "per_student_real_2023_24_aud", "type": "quantitative", "title": "Funding per student", "format": "$,.0f"}
    ]
  },
  "layer": [
    {
      "params": [
        {
          "name": "pick_state",
          "value": [{"state_abbr": "WA"}],
          "select": {"type": "point", "fields": ["state_abbr"], "on": "click[event.item && event.item.datum && event.item.datum.state_abbr]", "clear": false, "toggle": false}
        }
      ],
      "mark": {"type": "line", "color": "#c9cdd6", "strokeWidth": 3, "cursor": "pointer", "point": {"color": "#c9cdd6", "size": 80, "cursor": "pointer"}}
    },
    {
      "transform": [{"filter": {"param": "pick_state", "empty": false}}],
      "mark": {"type": "line", "color": "#5b3c94", "strokeWidth": 4, "point": {"color": "#5b3c94", "size": 100}}
    },
    {
      "transform": [{"filter": {"param": "pick_state", "empty": false}}, {"filter": "datum.year == '2014-15'"}],
      "mark": {"type": "text", "align": "right", "dx": -10, "fontWeight": "bold", "fontSize": 13, "color": "#5b3c94"},
      "encoding": {"text": {"field": "value_label", "type": "nominal"}}
    },
    {
      "transform": [
        {"filter": {"param": "pick_state", "empty": false}},
        {"filter": "datum.year == '2023-24'"},
        {"calculate": "[datum.state, datum.value_label]", "as": "label"}
      ],
      "mark": {"type": "text", "align": "left", "dx": 10, "fontWeight": "bold", "fontSize": 13, "color": "#5b3c94"},
      "encoding": {"text": {"field": "label", "type": "nominal"}}
    }
  ],
  "config": {"font": "Atkinson Hyperlegible", "view": {"stroke": null}}
}